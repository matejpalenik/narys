{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Software Factory formal property manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "property",
    "requirement_refs",
    "method",
    "tool",
    "coverage",
    "model",
    "harness",
    "command",
    "assumptions",
    "bounds",
    "verification_skill",
    "last_synchronized",
    "covered_inputs_digest",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^PROP-[0-9]+$"
    },
    "property": {
      "type": "string",
      "minLength": 1
    },
    "requirement_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "method": {
      "enum": [
        "model-check",
        "code-proof",
        "bounded-code-check",
        "empirical"
      ]
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paths",
        "symbols",
        "protected_state",
        "dependencies"
      ],
      "properties": {
        "paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "symbols": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "protected_state": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "model": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "harness": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "command": {
      "type": "string",
      "minLength": 1
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "bounds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "verification_skill": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "last_synchronized": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{40,64}$"
    },
    "covered_inputs_digest": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "enum": [
        "draft",
        "design_only",
        "synchronized",
        "defect",
        "blocked"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "synchronized"
          }
        }
      },
      "then": {
        "properties": {
          "last_synchronized": {
            "type": "string"
          },
          "covered_inputs_digest": {
            "type": "string"
          },
          "verification_skill": {
            "type": "string",
            "minLength": 1
          },
          "tool": {
            "properties": {
              "version": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "coverage": {
            "properties": {
              "paths": {
                "minItems": 1
              }
            }
          }
        }
      }
    }
  ]
}
