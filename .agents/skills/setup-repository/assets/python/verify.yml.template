# TEMPLATE: resolve all placeholders and verify approved actions/commands before use.
# Requires a real uv project, committed uv.lock, locked tools, and meaningful tests.
name: Verify

on:
  pull_request:
    branches: ["<approved-integration-branch>"]
  push:
    branches: ["<approved-integration-branch>"]
  # Add merge_group if an approved merge queue requires this check.

permissions:
  contents: read

jobs:
  verify:
    name: verify
    runs-on: ubuntu-latest
    timeout-minutes: 30
    env:
      UV_PYTHON: "<approved-python-version>"
    steps:
      - name: Checkout candidate
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1, verify at use
        with:
          persist-credentials: false
      - name: Install uv
        uses: astral-sh/setup-uv@c771a70e6277c0a99b617c7a806ffedaca235ff9 # v9.0.0, verify at use
        with:
          version: "<approved-uv-version>"
          enable-cache: false
      - name: Install approved Python and dependencies
        run: uv sync --locked
      - name: Check formatting
        run: uv run --locked ruff format --check .
      - name: Lint
        run: uv run --locked ruff check .
      - name: Check types
        run: uv run --locked pyright
      - name: Test
        run: uv run --locked pytest
      # Add approved architecture, build, security and other verification commands as required.
