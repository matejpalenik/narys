{
  "name": "@narys/app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname localhost",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "check:boundaries": "depcruise src --config .dependency-cruiser.cjs",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:browser": "playwright test",
    "db:generate:auth": "auth generate --config ./scripts/auth-schema.config.ts --adapter drizzle --dialect sqlite --output ./src/feature/architecture/infrastructure/access/schema-auth-sqlite.ts --yes",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.29",
    "@radix-ui/react-slot": "1.5.0",
    "@tanstack/ai": "1.8.0",
    "@tanstack/ai-anthropic": "1.2.1",
    "@tanstack/ai-ollama": "1.1.1",
    "@tanstack/ai-openai": "1.2.0",
    "@tanstack/react-query": "5.108.4",
    "@xyflow/react": "13.0.3",
    "better-auth": "1.7.29",
    "better-sqlite3": "13.2.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.83.0",
    "next": "16.4.6",
    "nuqs": "2.10.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@next/env": "16.4.6",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.11",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "auth": "1.7.29",
    "dependency-cruiser": "18.9.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-plugin-tsdoc": "0.5.4",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.2"
  }
}
