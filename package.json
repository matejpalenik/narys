{
  "name": "narys",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=26.10.0 <27",
    "pnpm": "10.32.1"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:browser": "turbo run test:browser",
    "test:browser:install": "pnpm --filter @narys/app exec playwright install chromium",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "check:boundaries": "turbo run check:boundaries",
    "format:check": "prettier --check apps/narys package.json pnpm-workspace.yaml turbo.json commitlint.config.mjs .github/workflows",
    "db:generate": "pnpm --filter @narys/app db:generate",
    "db:migrate": "pnpm --filter @narys/app db:migrate",
    "prepare": "husky"
  },
  "devDependencies": {
    "turbo": "2.11.13",
    "husky": "9.1.7",
    "prettier": "3.10.1",
    "@commitlint/cli": "21.3.0",
    "@commitlint/config-conventional": "21.3.0"
  }
}
